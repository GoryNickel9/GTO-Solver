{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtosd.local/schemas/postflop-tree-config-1.json",
  "title": "GTOSD HU postflop public tree configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "flop",
    "initial_pot_units",
    "effective_stack_units",
    "rake",
    "streets"
  ],
  "dependentRequired": {
    "river": ["turn"]
  },
  "properties": {
    "version": {
      "const": 1
    },
    "flop": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[6789TJQKA][cdhs]$"
      }
    },
    "turn": {
      "type": "string",
      "pattern": "^[6789TJQKA][cdhs]$"
    },
    "river": {
      "type": "string",
      "pattern": "^[6789TJQKA][cdhs]$"
    },
    "initial_pot_units": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "effective_stack_units": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "rake": {
      "$ref": "#/$defs/rake"
    },
    "streets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flop", "turn", "river"],
      "properties": {
        "flop": {
          "$ref": "#/$defs/street"
        },
        "turn": {
          "$ref": "#/$defs/street"
        },
        "river": {
          "$ref": "#/$defs/street"
        }
      }
    }
  },
  "$defs": {
    "rake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "percentage_bp",
        "cap_units",
        "no_flop_no_drop",
        "minimum_pot_units"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "percentage_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "cap_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "no_flop_no_drop": {
          "type": "boolean"
        },
        "minimum_pot_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sizes_bp",
        "raise_depth",
        "all_in_mode",
        "all_in_threshold_bp",
        "minimum_bet_units"
      ],
      "properties": {
        "sizes_bp": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "raise_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "all_in_mode": {
          "enum": ["disabled", "add", "go"]
        },
        "all_in_threshold_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "minimum_bet_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead", "after_check", "facing_bet"],
      "properties": {
        "lead": {
          "$ref": "#/$defs/scenario"
        },
        "after_check": {
          "$ref": "#/$defs/scenario"
        },
        "facing_bet": {
          "$ref": "#/$defs/scenario"
        }
      }
    },
    "street": {
      "type": "object",
      "additionalProperties": false,
      "required": ["co", "btn"],
      "properties": {
        "co": {
          "$ref": "#/$defs/player"
        },
        "btn": {
          "$ref": "#/$defs/player"
        }
      }
    }
  }
}
