{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtosd.local/schemas/gto_plus_reference.schema.json",
  "title": "GTOSD normalized GTO+ reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "game_fingerprint",
    "ev_co_antes",
    "ev_btn_antes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"const": "GTO+"},
    "game_fingerprint": {
      "type": "string",
      "pattern": "^fnv1a64:[0-9a-f]{16}$"
    },
    "ev_co_antes": {"type": "number"},
    "ev_btn_antes": {"type": "number"},
    "exported_at": {"type": "string"},
    "notes": {"type": "string"}
  }
}
