{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtosd.local/schemas/gto_plus_convergence_benchmark.schema.json",
  "title": "GTOSD end-to-end GTO+ convergence benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "source",
    "fixture",
    "gto_plus_reference",
    "gtosd_run",
    "expected_layout"
  ],
  "properties": {
    "schema": {"const": "gtosd.gto_plus_convergence_benchmark.v1"},
    "benchmark_id": {"const": "GTP-AHKHQH-003"},
    "source": {"const": "GTO+"},
    "fixture": {"type": "object"},
    "gto_plus_reference": {
      "type": "object",
      "required": [
        "elapsed_seconds",
        "solver_memory_bytes",
        "target_dev_percent",
        "target_definition",
        "flop_ev_antes",
        "flop_action_frequencies",
        "metadata_complete"
      ],
      "properties": {
        "elapsed_seconds": {"type": "number", "exclusiveMinimum": 0},
        "solver_memory_bytes": {"type": "integer", "minimum": 1},
        "target_dev_percent": {"const": 1.0},
        "target_definition": {
          "const": "maximum unilateral best-response gain divided by the initial pot"
        },
        "target_provenance": {"type": "string"},
        "timing_scope": {"type": "string"},
        "flop_ev_antes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display_convention",
            "absolute_tolerance_antes",
            "co_root",
            "btn_after_co_check",
            "btn_after_co_bet_20"
          ],
          "properties": {
            "display_convention": {"type": "string"},
            "absolute_tolerance_antes": {"type": "number", "exclusiveMinimum": 0},
            "co_root": {"const": 19.15},
            "btn_after_co_check": {"const": 21.65},
            "btn_after_co_bet_20": {"const": 17.51}
          }
        },
        "flop_action_frequencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "absolute_tolerance_fraction",
            "display_precision_percent",
            "flop_co_root",
            "flop_btn_after_co_bet_20"
          ],
          "properties": {
            "absolute_tolerance_fraction": {"const": 0.01},
            "display_precision_percent": {"const": 0.1},
            "flop_co_root": {
              "const": {"check": 0.803, "bet_20": 0.197}
            },
            "flop_btn_after_co_bet_20": {
              "const": {"fold": 0.374, "call_20": 0.626, "raise_60": 0.0}
            }
          }
        },
        "metadata_complete": {"type": "boolean"}
      }
    },
    "gtosd_run": {
      "type": "object",
      "required": [
        "maximum_iterations",
        "certification_interval",
        "averaging_delay",
        "parallel_action_depth",
        "maximum_solver_threads",
        "independent_processes"
      ],
      "properties": {
        "maximum_iterations": {"type": "integer", "minimum": 1},
        "certification_interval": {"type": "integer", "minimum": 1},
        "averaging_delay": {"type": "integer", "minimum": 0},
        "parallel_action_depth": {"const": 5},
        "maximum_solver_threads": {"const": 6},
        "independent_processes": {"type": "integer", "minimum": 5},
        "timer_scope": {"type": "string"}
      }
    },
    "expected_layout": {
      "type": "object",
      "required": [
        "game_fingerprint",
        "physical_public_nodes",
        "canonical_public_nodes",
        "information_sets",
        "actions",
        "solver_state_bytes"
      ],
      "properties": {
        "game_fingerprint": {"const": "fnv1a64:001a19fa48cd8b1e"},
        "physical_public_nodes": {"const": 112848},
        "canonical_public_nodes": {"const": 31461},
        "information_sets": {"const": 250704},
        "actions": {"const": 526872},
        "solver_state_bytes": {"const": 4214976}
      }
    }
  }
}
