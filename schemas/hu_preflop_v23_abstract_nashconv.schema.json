{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtosd.local/schemas/hu_preflop_v23_abstract_nashconv.schema.json",
  "title": "GTOSD V23 HU preflop abstract NashConv certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "nashconv_certified",
    "physical_nashconv_certified",
    "scope",
    "game_id",
    "identity",
    "chance_corpus",
    "finite_game_census",
    "solver",
    "final",
    "checkpoints",
    "timing",
    "limitations"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {"const": "gtosd.hu_preflop_v23_abstract_nashconv.v2"}
        }
      },
      "then": {
        "required": ["policy_completion"],
        "properties": {
          "timing": {"required": ["policy_coverage_seconds"]}
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "enum": [
        "gtosd.hu_preflop_v23_abstract_nashconv.v1",
        "gtosd.hu_preflop_v23_abstract_nashconv.v2"
      ]
    },
    "status": {
      "enum": [
        "CERTIFIED_ABSTRACT_EMPIRICAL_CHANCE_TARGET_MET",
        "CERTIFIED_ABSTRACT_EMPIRICAL_CHANCE_TARGET_NOT_MET"
      ]
    },
    "nashconv_certified": {"const": true},
    "physical_nashconv_certified": {"const": false},
    "scope": {
      "const": "exact_finite_game_with_stratified_empirical_complete_deal_chance_v1"
    },
    "game_id": {"type": "string", "minLength": 1},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_fingerprint",
        "tree_fingerprint",
        "abstraction_fingerprint",
        "abstract_game_definition_fingerprint",
        "chance_corpus_fingerprint",
        "finite_game_fingerprint"
      ],
      "properties": {
        "rules_fingerprint": {"type": "string", "minLength": 1},
        "tree_fingerprint": {"type": "string", "minLength": 1},
        "abstraction_fingerprint": {"type": "string", "minLength": 1},
        "abstract_game_definition_fingerprint": {"type": "string", "minLength": 1},
        "chance_corpus_fingerprint": {"type": "string", "minLength": 1},
        "finite_game_fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "chance_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "deals_per_co_class", "outcomes", "co_class_marginal", "btn_holes_and_board"],
      "properties": {
        "seed": {"type": "integer", "minimum": 1},
        "deals_per_co_class": {"type": "integer", "minimum": 1},
        "outcomes": {"type": "integer", "minimum": 81},
        "co_class_marginal": {"const": "exact_physical_combo_mass"},
        "btn_holes_and_board": {"const": "conditional_empirical"}
      }
    },
    "finite_game_census": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "terminal_nodes", "chance_nodes", "decision_nodes", "information_sets", "maximum_depth", "minimum_materialized_bytes"],
      "properties": {
        "nodes": {"type": "integer", "minimum": 1},
        "terminal_nodes": {"type": "integer", "minimum": 1},
        "chance_nodes": {"type": "integer", "minimum": 1},
        "decision_nodes": {"type": "integer", "minimum": 1},
        "information_sets": {"type": "integer", "minimum": 1},
        "maximum_depth": {"type": "integer", "minimum": 1},
        "minimum_materialized_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "strategy", "iterations", "certification_interval", "seed", "resumed", "checkpoint_input", "checkpoint_output", "maximum_strategy_normalization_error", "traversed_nodes"],
      "properties": {
        "algorithm": {"const": "linear_mccfr"},
        "strategy": {"const": "average"},
        "iterations": {"type": "integer", "minimum": 1},
        "requested_iterations": {"type": "integer", "minimum": 1},
        "certification_interval": {"type": "integer", "minimum": 1},
        "stop_on_target": {"type": "boolean"},
        "stopped_early_on_target": {"type": "boolean"},
        "seed": {"type": "integer", "minimum": 1},
        "resumed": {"type": "boolean"},
        "checkpoint_input": {"type": ["string", "null"]},
        "checkpoint_output": {"type": ["string", "null"]},
        "maximum_strategy_normalization_error": {"type": "number", "minimum": 0},
        "traversed_nodes": {"type": "integer", "minimum": 1}
      }
    },
    "policy_completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "target_game_fingerprint",
        "supplied_information_sets",
        "required_information_sets",
        "matched_information_sets",
        "unseen_information_sets",
        "unused_supplied_information_sets",
        "required_information_sets_by_player",
        "unseen_information_sets_by_player",
        "decision_nodes",
        "unseen_decision_nodes",
        "exact_key_coverage",
        "total_decision_reach_mass",
        "unseen_decision_reach_mass",
        "reach_weighted_coverage",
        "total_decision_reach_mass_by_player",
        "unseen_decision_reach_mass_by_player",
        "reach_weighted_coverage_by_player"
      ],
      "properties": {
        "contract": {"const": "uniform_unseen_v1"},
        "target_game_fingerprint": {"type": "string", "minLength": 1},
        "supplied_information_sets": {"type": "integer", "minimum": 0},
        "required_information_sets": {"type": "integer", "minimum": 0},
        "matched_information_sets": {"type": "integer", "minimum": 0},
        "unseen_information_sets": {"type": "integer", "minimum": 0},
        "unused_supplied_information_sets": {"type": "integer", "minimum": 0},
        "required_information_sets_by_player": {"$ref": "#/$defs/nonnegative_integer_pair"},
        "unseen_information_sets_by_player": {"$ref": "#/$defs/nonnegative_integer_pair"},
        "decision_nodes": {"type": "integer", "minimum": 0},
        "unseen_decision_nodes": {"type": "integer", "minimum": 0},
        "exact_key_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "total_decision_reach_mass": {"type": "number", "minimum": 0},
        "unseen_decision_reach_mass": {"type": "number", "minimum": 0},
        "reach_weighted_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "total_decision_reach_mass_by_player": {"$ref": "#/$defs/nonnegative_number_pair"},
        "unseen_decision_reach_mass_by_player": {"$ref": "#/$defs/nonnegative_number_pair"},
        "reach_weighted_coverage_by_player": {"$ref": "#/$defs/coverage_pair"}
      }
    },
    "final": {"$ref": "#/$defs/metrics"},
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/metrics"},
          {
            "type": "object",
            "required": ["iteration", "checkpoint_fingerprint"],
            "properties": {
              "iteration": {"type": "integer", "minimum": 1},
              "checkpoint_fingerprint": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile_seconds", "linear_mccfr_seconds", "exact_nashconv_seconds", "total_seconds"],
      "properties": {
        "compile_seconds": {"type": "number", "minimum": 0},
        "linear_mccfr_seconds": {"type": "number", "minimum": 0},
        "exact_nashconv_seconds": {"type": "number", "minimum": 0},
        "policy_coverage_seconds": {"type": "number", "minimum": 0},
        "total_seconds": {"type": "number", "minimum": 0}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "pair": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "nonnegative_integer_pair": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "nonnegative_number_pair": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "coverage_pair": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "metrics": {
      "type": "object",
      "required": ["profile_ev_ante", "best_response_ev_ante", "deviation_gain_ante", "nashconv_ante", "normalized_nashconv", "normalized_dev"],
      "properties": {
        "profile_ev_ante": {"$ref": "#/$defs/pair"},
        "best_response_ev_ante": {"$ref": "#/$defs/pair"},
        "deviation_gain_ante": {"$ref": "#/$defs/pair"},
        "nashconv_ante": {"type": "number", "minimum": 0},
        "normalized_nashconv": {"type": "number", "minimum": 0},
        "normalized_dev": {"type": "number", "minimum": 0},
        "target_normalized_dev": {"type": "number", "exclusiveMinimum": 0},
        "target_met": {"type": "boolean"},
        "iteration": {"type": "integer", "minimum": 1},
        "checkpoint_fingerprint": {"type": "string", "minLength": 1}
      }
    }
  }
}
