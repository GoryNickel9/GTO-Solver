{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "gtosd",
  "version-semver": "0.10.0",
  "builtin-baseline": "cd61e1e26a038e82d6550a3ebbe0fbbfe7da78e3",
  "dependencies": [
    "benchmark",
    "gtest",
    "nlohmann-json",
    "libsodium",
    "sqlite3",
    "spdlog",
    "zstd"
  ],
  "features": {
    "gui-prototypes": {
      "description": "Phase 9 Qt 6 Widgets and Dear ImGui docking prototypes",
      "dependencies": [
        {
          "name": "imgui",
          "default-features": false,
          "features": [
            "docking-experimental",
            "dx11-binding",
            "win32-binding"
          ]
        },
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "testlib",
            "widgets",
            "windeployqt"
          ]
        }
      ]
    }
  }
}
